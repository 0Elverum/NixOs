layout {

    focus-ring {
        active-color   "#bcc2ff"
        inactive-color "#131318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcc2ff"
        inactive-color "#131318"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bcc2ff"
        inactive-color "#3e478d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcc2ff80"
    }
}

recent-windows {
    highlight {
        active-color "#bcc2ff"
        urgent-color "#ffb4ab"
    }
}
