binds {
    Mod+D hotkey-overlay-title="App Launcher: Toggle" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Super+N hotkey-overlay-title="Notepad: Toggle" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+T hotkey-overlay-title="Open a Terminal: Kitty" { spawn "kitty"; }
    Super+E repeat=false hotkey-overlay-title="Open File Manager: Thunar" { spawn "thunar"; }
}
